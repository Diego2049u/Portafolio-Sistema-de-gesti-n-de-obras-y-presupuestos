# Copy this file to .env and replace the secret and local-network addresses.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
FYAG_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50
FYAG_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.50:5173
FYAG_TRUST_PROXY_HEADERS=false
FYAG_SECURE_SSL_REDIRECT=false
FYAG_HSTS_SECONDS=0
FYAG_HSTS_INCLUDE_SUBDOMAINS=false
FYAG_HSTS_PRELOAD=false
